<Window x:Class="GazeStream.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GazeStream.Windows"
        xmlns:controls="clr-namespace:GazeStream.Controls"
        xmlns:converters ="clr-namespace:GazeStream.Converters"
        mc:Ignorable="d"
        Title="CalibrationWindow"  
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        Topmost="False"
        xmlns:settings="clr-namespace:GazeStream.AppData"      
        d:DataContext="{d:DesignInstance Type=settings:Settings}"
        Height="1080" Width="1920">

    <!--WindowStyle="None"
        ResizeMode="NoResize"-->
    <!-- ================= RESOURCES ================= -->
    <Window.Resources>

        <Style x:Key="OptionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,8,20,8"/>
        </Style>

        <!-- Rounded button style (WPF-compatible) -->
        <Style x:Key="CalibrationButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="Margin" Value="10"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                        Background="{StaticResource SeriousButton}"
                        BorderBrush="White"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <EventTrigger RoutedEvent="Button.Click">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                    Storyboard.TargetName="ButtonBorder"
                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                    To="#FFA0D992"
                    Duration="0:0:0.08"
                    AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{StaticResource SeriousBackground}">

        <!-- Overlay canvas -->
        <Canvas x:Name="MainCanvas"
                Background="Transparent"
                IsHitTestVisible="False"/>

        <!-- Eye display -->
        <controls:EyeDisplay x:Name="EyeDisplay" Width="484" Height="484"/>

        <Border x:Name="BordePuntero" BorderThickness="2" BorderBrush="Green" Margin="{Binding ClampDistance.Value}"/>
        <Border x:Name="BordeImantado" BorderThickness="2" BorderBrush="Red" Margin="{Binding EdgeBiasFilter.Value}"/>

        <Button x:Name="CloseButton" Background="Red" Click="Back_Click" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Top">
            <TextBlock Text="X" Foreground="White" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>


        <!-- Settings panel -->
        <Border x:Name="SettingsPanel"
                Background="{StaticResource SeriousPanel}"
                CornerRadius="12"
                Padding="30"
                MinWidth="700"
                MinHeight="350"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="Opciones de Calibración"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Options grid -->
                <Grid Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Labels -->
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Seleccione ojos a calibrar"
                               Style="{StaticResource OptionTitle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Seleccione cantidad de puntos a calibrar"
                               Style="{StaticResource OptionTitle}"/>

                    <!--<TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Seleccione filtro de calibración"
                               Style="{StaticResource OptionTitle}"/>-->

                    <!-- Eyes -->
                    <RadioButton Grid.Row="0" Grid.Column="1"
                                 GroupName="EyesSetting"
                                 x:Name="EyeSetting_Left"
                                 Content="Ojo izquierdo"
                                 Margin="10"/>

                    <RadioButton Grid.Row="0" Grid.Column="2"
                                 GroupName="EyesSetting"
                                 x:Name="EyeSetting_Right"
                                 Content="Ojo derecho"
                                 Margin="10"/>

                    <RadioButton Grid.Row="0" Grid.Column="3"
                                 GroupName="EyesSetting"
                                 x:Name="EyeSetting_Both"
                                 Content="Ambos ojos"
                                 IsChecked="True"
                                 Margin="10"/>

                    <!-- Points -->
                    <RadioButton Grid.Row="1" Grid.Column="1"
                                 GroupName="PointsSetting"
                                 x:Name="PointsSetting_3"
                                 Content="3 puntos"
                                 Margin="10"/>

                    <RadioButton Grid.Row="1" Grid.Column="2"
                                 GroupName="PointsSetting"
                                 x:Name="PointsSetting_5"
                                 Content="5 puntos"
                                 Margin="10"/>

                    <RadioButton Grid.Row="1" Grid.Column="3"
                                 GroupName="PointsSetting"
                                 x:Name="PointsSetting_9"
                                 Content="9 puntos"
                                 IsChecked="True"
                                 Margin="10"/>

                    <!-- Filter -->
                    <!--<RadioButton Grid.Row="2" Grid.Column="1"
                                 GroupName="FilterSetting"
                                 x:Name="FilterSetting_Bajo"
                                 Content="Bajo"
                                 Margin="10"
                                 Checked="FilterSetting_Checked"/>

                    <RadioButton Grid.Row="2" Grid.Column="2"
                                 GroupName="FilterSetting"
                                 x:Name="FilterSetting_Medio"
                                 Content="Medio"
                                 Margin="10"
                                 Checked="FilterSetting_Checked"/>

                    <RadioButton Grid.Row="2" Grid.Column="3"
                                 GroupName="FilterSetting"
                                 x:Name="FilterSetting_Alto"
                                 Content="Alto"
                                 IsChecked="True"
                                 Margin="10"
                                 Checked="FilterSetting_Checked"/>-->

                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,10">

                    <Button x:Name="StartCalibrationButton"
                            Style="{StaticResource CalibrationButton}"
                            Click="StartCalibration_Click">
                        <TextBlock Text="Iniciar Calibración"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="BackButton"
   Style="{StaticResource CalibrationButton}"
   Click="Back_Click">
                        <TextBlock Text="Volver"
          TextWrapping="Wrap"
          TextAlignment="Center"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="Calibración Automática"  FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
                <StackPanel Grid.Row="3"
             Orientation="Horizontal"
             HorizontalAlignment="Center"
             Margin="0,20,0,0">

                    <Button x:Name="FastCalibLeft"
             Style="{StaticResource CalibrationButton}"
             Click="DefaultCalibrationLeft_Click">
                        <TextBlock Text="Calibración Rápida Ojo Izquierdo"
                    TextWrapping="Wrap"
                    TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="FastCalibRight"
             Style="{StaticResource CalibrationButton}"
             Click="DefaultCalibrationRight_Click">
                        <TextBlock Text="Calibración Rápida Ojo Derecho"
                TextWrapping="Wrap"
                TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="FastCalibBoth"
             Style="{StaticResource CalibrationButton}"
             Click="DefaultCalibration_Click">
                        <TextBlock Text="Calibración Rápida Ambos Ojos"
                    TextWrapping="Wrap"
                    TextAlignment="Center"/>
                    </Button>

                    <Button x:Name="FastCalibList" 
             Style="{StaticResource CalibrationButton}"
             Click="BestCalibration_Click">
                        <TextBlock Text="Calibración Automática"
       TextWrapping="Wrap"
       TextAlignment="Center"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                    <TextBlock Text="Guardar/Cargar Calibración"  FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>
                    <UniformGrid Columns="5" HorizontalAlignment="Stretch">

                        <!-- Slot 1 -->
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource CalibrationButton}" Click="LoadCalibration1_Click">
                                <StackPanel>
                                    <TextBlock Text="Calibración 1" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Calibration1.Value, Converter={StaticResource CalibrationSlotTextConverter}}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Style="{StaticResource CalibrationButton}" Margin="0,0,0,0" Click="SaveCalibration1_Click">
                                <TextBlock Text="Guardar" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Slot 2 -->
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource CalibrationButton}" Click="LoadCalibration2_Click">
                                <StackPanel>
                                    <TextBlock Text="Calibración 2" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Calibration2.Value, Converter={StaticResource CalibrationSlotTextConverter}}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Style="{StaticResource CalibrationButton}" Margin="0,0,0,0" Click="SaveCalibration2_Click">
                                <TextBlock Text="Guardar" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Slot 3 -->
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource CalibrationButton}" Click="LoadCalibration3_Click">
                                <StackPanel>
                                    <TextBlock Text="Calibración 3" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Calibration3.Value, Converter={StaticResource CalibrationSlotTextConverter}}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Style="{StaticResource CalibrationButton}" Margin="0,0,0,0" Click="SaveCalibration3_Click">
                                <TextBlock Text="Guardar" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Slot 4 -->
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource CalibrationButton}" Click="LoadCalibration4_Click">
                                <StackPanel>
                                    <TextBlock Text="Calibración 4" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Calibration4.Value, Converter={StaticResource CalibrationSlotTextConverter}}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Style="{StaticResource CalibrationButton}" Margin="0,0,0,0" Click="SaveCalibration4_Click">
                                <TextBlock Text="Guardar" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Slot 5 -->
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource CalibrationButton}" Click="LoadCalibration5_Click">
                                <StackPanel>
                                    <TextBlock Text="Calibración 5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Calibration5.Value, Converter={StaticResource CalibrationSlotTextConverter}}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Row="1" Style="{StaticResource CalibrationButton}" Margin="0,0,0,0" Click="SaveCalibration5_Click">
                                <TextBlock Text="Guardar" HorizontalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="5" Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                    <TextBlock Grid.Row="3" Text="Filtros"  FontWeight="Bold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0"/>

                    <Grid Margin="170,10,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Filtro Interpolación" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Slider x:Name="LerpSlider" Grid.Column="1" Width="150" Minimum="0" Maximum="0.25" IsSnapToTickEnabled="True" TickFrequency="0.01" Value="{Binding InterpolationFilter.Value}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=LerpSlider, StringFormat={}{0:F2}}" Foreground="White" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="170,10,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Filtro Kalman" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Slider x:Name="KalmanSlider" Grid.Column="1" Width="150" Minimum="0" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="0.1" Value="{Binding KalmanFilter.Value}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=KalmanSlider, StringFormat={}{0:F2}}" Foreground="White" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="170,10,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Filtro Joaco" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Slider x:Name="JoacoSlider" Grid.Column="1" Width="150" Minimum="1" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding SmoothFilter.Value}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=JoacoSlider, StringFormat={}{0:F2}}" Foreground="White" HorizontalAlignment="Left"/>
                    </Grid>

                    <Grid Margin="170,10,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Borde Imantado" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Slider x:Name="EdgeSlider" Grid.Column="1" Width="150" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding EdgeBiasFilter.Value}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=EdgeSlider, StringFormat={}{0:F3}}" Foreground="White" HorizontalAlignment="Left"/>
                    </Grid>


                    <Grid Margin="170,10,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48*" />
                            <ColumnDefinition Width="178*"/>
                            <ColumnDefinition Width="227*" />
                            <ColumnDefinition Width="227*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Límite de Puntero" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
                        <Slider x:Name="ClampSlider" Grid.Column="2" Width="150" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding ClampDistance.Value}" Margin="38,0,38,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=ClampSlider, StringFormat={}{0:F2}}" Foreground="White" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="226,0,0,0"/>
                    </Grid>
                    <Grid Margin="170,5,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Activar Límite de Puntero" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ModernToggleStyle}" IsChecked="{Binding ClampBubblePosition.Value, Mode=TwoWay}" HorizontalAlignment="Left" Margin="35,0"/>
                    </Grid>

                    <Grid Margin="170,5,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Filtrar puntos dudosos" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ModernToggleStyle}" IsChecked="{Binding FilterOutlierPoints.Value, Mode=TwoWay}" HorizontalAlignment="Left" Margin="35,0" />
                    </Grid>

                    <!--<Grid Margin="170,5,0,0" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />

                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Calibración Dinámica (Experimental)" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ModernToggleStyle}" IsChecked="{Binding DynamicCalibrationToggle.Value, Mode=TwoWay}" HorizontalAlignment="Left" Margin="35,0" />
                    </Grid>-->
                </StackPanel>

            </Grid>
        </Border>

        <Border x:Name="RestartPanel" Width="350" Height="150" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20" CornerRadius="12" Background="{StaticResource SeriousPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource OptionTitle}" Text="Este punto está tardando demasiado. Te recomendamos empezar de nuevo" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource CalibrationButton}" Click="CancelCalibration_Click">
                        <TextBlock Text="Empezar de nuevo" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CalibrationButton}" Click="CloseRestartCalibrationWindow">
                        <TextBlock Text="Reintentar punto" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error text -->
        <TextBlock x:Name="ErrorText"
                   Foreground="White"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="0,0,0,20"
                   IsHitTestVisible="False"/>

        <!-- Fade text -->
        <controls:FadeText x:Name="FadeText"
                           FontSize="50"
                           TextColor="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           IsHitTestVisible="False"/>

    </Grid>
</Window>
